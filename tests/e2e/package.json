    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@parc-auto/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@parc-auto/db": "workspace:*",
    "pg": "8.23.0"
  }
}
