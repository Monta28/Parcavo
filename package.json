{
  "name": "parc-auto",
  "version": "1.0.0",
  "private": true,
  "description": "Parc Auto — gestion de parc automobile multi-sociétés (CDC v1.1)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build && pnpm check:secrets:bundle",
    "check:secrets": "node scripts/tests/check-secrets.mjs",
    "check:secrets:bundle": "node scripts/tests/check-secrets.mjs --bundle-only --require-bundle",
    "check:ops": "bash scripts/tests/check-image-tags.sh && bash scripts/tests/check-exposed-ports.sh && bash scripts/tests/check-env-example.sh && bash scripts/tests/check-production-claim.sh",
    "ci:check": "bash scripts/tests/ci.sh",
    "db:generate": "pnpm --filter @parc-auto/db generate",
    "db:migrate": "pnpm --filter @parc-auto/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @parc-auto/db migrate:dev",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm check:secrets && pnpm check:ops && pnpm -r --workspace-concurrency=1 --if-present lint",
    "packages:build": "pnpm --filter @parc-auto/contracts build && pnpm --filter @parc-auto/db generate && pnpm --filter @parc-auto/api build",
    "postinstall": "pnpm packages:build",
    "test": "pnpm test:secrets && pnpm test:ops && pnpm -r --workspace-concurrency=1 --if-present test",
    "test:secrets": "node --test scripts/tests/check-secrets.test.mjs",
    "test:ops": "node --test scripts/tests/check-ops.test.mjs",
    "seed:demo": "pnpm --filter @parc-auto/api seed:demo",
    "seed:load": "pnpm --filter @parc-auto/api seed:load",
    "test:load": "node scripts/tests/load-test.mjs",
    "test:e2e": "pnpm --filter @parc-auto/e2e test:e2e",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:unit": "pnpm -r --workspace-concurrency=1 --if-present test:unit",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
