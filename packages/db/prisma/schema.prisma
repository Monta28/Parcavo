// =============================================================================
// Parc Auto — schéma de données (CDC v1.1, section 13)
// -----------------------------------------------------------------------------
// Conventions (13.1) :
//  - Identifiants UUID v7 ; createdAt / updatedAt / createdById / version sur
//    les objets modifiables ; organizationId sur toutes les données métier ;
//    companyId sur les objets appartenant à une société. Les événements portent
//    leur companyId historique (jamais recalculé après un transfert).
//  - Montants et quantités DECIMAL(18,3) ; kilomètres DECIMAL(15,3).
//  - Horodatages TIMESTAMPTZ (UTC) ; dates civiles en DATE (sans fuseau).
//  - Relations obligatoires protégées par des clés composites
//    (id, organizationId) : une relation entre organisations est impossible.
//  - Les colonnes d'acteur (createdById, approvedById...) ne portent pas de FK :
//    les utilisateurs ne sont jamais supprimés physiquement (désactivation).
//  - Contraintes non représentables ici (EXCLUDE, CHECK, triggers, partitions)
//    : migrations SQL versionnées dans prisma/migrations.
// Tables techniques globales (sans organizationId) : JobLease,
// WorkerHeartbeat. Voir docs/DECISIONS.md.
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

