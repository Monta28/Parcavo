{
  "name": "@parc-auto/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parc Auto — worker : jobs PostgreSQL, outbox e-mail, rattrapage des alertes, synchronisation télématique",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@parc-auto/api": "workspace:*",
    "@parc-auto/db": "workspace:*",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/testing": "12.1.0",
    "@parc-auto/config": "workspace:*",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
