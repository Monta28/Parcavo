# =============================================================================
# Parc Auto — variables d'environnement (copier vers .env ; aucun secret dans le dépôt)
# =============================================================================
# Ce modèle ne contient aucune valeur secrète : chaque secret est vide et se génère à l'installation
# (commande indiquée). Le fichier .env n'est jamais versionné (.gitignore) ; `pnpm check:secrets`
# refuse toute valeur sensible écrite dans le dépôt et `pnpm check:ops` vérifie que ce modèle documente
# toutes les variables lues par l'API, le web, les commandes, les compose, le Caddyfile et scripts/ops.
#
# Deux usages :
#  - développement (`pnpm dev`, `docker compose up -d`) : sections « Général » à « Télématique » ;
#  - production (`docker compose -f docker-compose.prod.yml …`, qui lit ce .env) : section
#    « Production » obligatoire ; le compose de production fixe lui-même NODE_ENV=production,
#    DATABASE_URL (réseau interne), APP_ORIGIN=https://DOMAIN, COOKIE_SECURE, TRUST_PROXY et STORAGE_DIR.

# --- Production (docker-compose.prod.yml, deploy/Caddyfile) ------------------
# Nom de domaine public servi en HTTPS par Caddy (certificat Let's Encrypt automatique). Obligatoire.
DOMAIN=
# Adresse de contact du certificat ACME (Let's Encrypt). Obligatoire.
ACME_EMAIL=
# Compte et base PostgreSQL du conteneur « postgres » (réseau interne, aucun port publié).
POSTGRES_USER=parc_auto
POSTGRES_DB=parc_auto
# Mot de passe PostgreSQL. Obligatoire en production. Génération : openssl rand -base64 24
# (en développement, vide = mot de passe local « parc_auto_dev » du docker-compose.yml).
POSTGRES_PASSWORD=

# --- Général ---------------------------------------------------------------
NODE_ENV=development
# Origine publique du site (utilisée pour les cookies, le contrôle d'origine CSRF et les liens e-mail)
APP_ORIGIN=http://localhost:3000
# Port de l'API NestJS
PORT=3001
# Origine interne de l'API vue par Next.js (relais /api/v1 lu à l'exécution, et appels serveur)
API_INTERNAL_URL=http://localhost:3001
LOG_LEVEL=debug
# Derrière un reverse proxy HTTPS : true (lecture de X-Forwarded-*)
TRUST_PROXY=false
# Limitation de débit en mémoire par adresse IP (connexion, mot de passe oublié…). Toujours active si
# NODE_ENV=production (la valeur est alors ignorée) ; désactivable uniquement pour les tests automatisés.
RATE_LIMIT_ENABLED=true

# --- Base de données ---------------------------------------------------------
DATABASE_URL=postgresql://parc_auto:parc_auto_dev@localhost:5432/parc_auto
# Délai maximal (millisecondes) d'obtention d'une connexion du pool PostgreSQL de l'API et du worker
# (connexion nouvelle ou attente d'une connexion libre) : au-delà, la requête échoue au lieu d'attendre
# sans limite. Entier strictement positif ; 10000 (10 s) par défaut.
DATABASE_CONNECTION_TIMEOUT_MS=10000
# Base de test (tests d'intégration et e2e) — jamais la base de production : les préparations de test
# refusent toute URL dont la base ne s'appelle pas parc_auto_test…
TEST_DATABASE_URL=postgresql://parc_auto:parc_auto_test@localhost:5433/parc_auto_test
# Ports publiés sur le poste de développement par docker-compose.yml (jamais en production).
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- Sessions et sécurité ---------------------------------------------------
# Cookies Secure (obligatoire en production, derrière HTTPS)
COOKIE_SECURE=false
# Durée de session : paramètre « session.ttlHours » (12 h par défaut), modifiable dans
# Administration > Paramètres ; aucune variable d'environnement.
# Clé de chiffrement au repos des secrets télématiques : 32 octets aléatoires en base64
# Génération : openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_ID=k1
# Rotation (D-304) : anciennes clés conservées pour le seul déchiffrement, « kid:base64,kid:base64 ».
# Procédure : nouvelle clé active (SECRETS_ENCRYPTION_KEY / _KEY_ID), ancienne clé déplacée ici,
# puis `pnpm --filter @parc-auto/api telemetry:rotate-secrets` (simulation) et `... -- --apply`,
# enfin retrait de l'ancienne clé de cette liste une fois le rechiffrement confirmé.
SECRETS_ENCRYPTION_PREVIOUS_KEYS=

# --- Fichiers privés ---------------------------------------------------------
# Répertoire de stockage des pièces jointes (volume persistant en production)
STORAGE_DIR=./storage

# --- E-mail (facultatif : sans SMTP, le centre d'alertes fonctionne et affiche « Canal e-mail non configuré ») ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parc-auto@example.tn

# --- Télématique (module F11) ------------------------------------------------
# F11 est désactivé par défaut et s'active par société dans Administration > Télématique ; l'application
# fonctionne entièrement sans lui. Les identifiants des fournisseurs GPS ne sont jamais dans
# l'environnement : saisis dans l'interface, ils sont chiffrés au repos avec SECRETS_ENCRYPTION_KEY.
# Simulateur de fournisseur pour les tests : refusé si NODE_ENV=production
TELEMETRY_SIMULATOR_ENABLED=false

# --- Sauvegardes (scripts/ops/backup.sh, restore.sh, restore-test.sh) --------
# Les scripts lisent ces variables dans l'environnement du shell (ex. `set -a; . ./.env; set +a`).
# Phrase de chiffrement des archives (AES-256). Obligatoire pour sauvegarder et restaurer ; à conserver
# hors du serveur (coffre de mots de passe). Génération : openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# Répertoire local des archives et rétention locale en jours (30 jours proposés par le CDC 16.4).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Copie hors site facultative par rclone (« distant:chemin » configuré dans rclone) ; vide : aucune copie.
BACKUP_REMOTE=
# Fichier et projet compose visés par les scripts d'exploitation (défaut : docker-compose.prod.yml, projet
# du répertoire courant) ; scripts/tests/restart-persistence.sh et restore-test.sh créent leur propre projet.
# Laissées en commentaire : Docker Compose lit aussi COMPOSE_FILE dans ce .env, et une valeur ici ferait
# viser le compose de production par un simple `docker compose up` de développement.
# COMPOSE_FILE=docker-compose.prod.yml
# COMPOSE_PROJECT_NAME=parc-auto

# --- Commandes d'administration (jamais en argument de ligne de commande) ----
# Premier administrateur (create-admin, docs/installation.md §5) : saisi au clavier ou fourni ici le
# temps de la commande, puis retiré (unset).
# ADMIN_PASSWORD=

# --- Jeu de démonstration (pnpm seed:demo ; refusé si NODE_ENV=production) ---
# Mot de passe commun des comptes fictifs (12 caractères minimum, minuscules, majuscules et chiffres).
# Laissé vide ou absent : généré aléatoirement et affiché une seule fois à la fin du chargement.
# DEMO_PASSWORD=

# --- Jeu de dimensionnement et test de charge (hors production, CDC 17.2) -----
# Mot de passe commun des 50 comptes du jeu de charge (seed-load, 12 caractères minimum) ; API et
# origine visées par scripts/tests/load-test.mjs.
# LOAD_PASSWORD=
# LOAD_API_URL=http://127.0.0.1:3990
# LOAD_ORIGIN=http://localhost:3000

# --- Tests automatisés (facultatif) ------------------------------------------
# Serveur SMTP de test (Mailpit du docker-compose.yml) utilisé par les tests d'e-mail.
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025
# MAILPIT_API_URL=http://localhost:8025
# Parcours Playwright : ports de l'API et du web lancés par tests/e2e, stockage des pièces jointes,
# navigateur Chromium.
# E2E_WEB_PORT=3900
# E2E_API_PORT=3901
# E2E_STORAGE_DIR=tests/e2e/.storage
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# --- Version déployée (facultative, étiquette des images et du battement du worker) --
APP_VERSION=
