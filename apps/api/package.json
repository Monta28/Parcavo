{
  "name": "@parc-auto/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parc Auto — API REST NestJS (/api/v1), autorisations serveur, OpenAPI",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.config.integration.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "openapi:export": "pnpm run build && node dist/cli/export-openapi.js",
    "telemetry:rotate-secrets": "node dist/cli/rotate-telemetry-secrets.js",
    "seed:demo": "node dist/cli/seed-demo.js",
    "seed:load": "node dist/cli/seed-load.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@parc-auto/contracts": "workspace:*",
    "@parc-auto/db": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "imapflow": "2.0.6",
    "luxon": "3.7.2",
    "mailparser": "3.9.28",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ssh2-sftp-client": "12.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/testing": "12.1.0",
    "@parc-auto/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.5",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/ssh2-sftp-client": "9.0.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
