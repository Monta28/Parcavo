{
  "name": "parc-auto",
  "version": "1.0.0",
  "private": true,
  "description": "Parc Auto — gestion de parc automobile multi-sociétés (CDC v1.1)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "db:generate": "pnpm --filter @parc-auto/db generate",
    "db:migrate": "pnpm --filter @parc-auto/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @parc-auto/db migrate:dev",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "packages:build": "pnpm --filter @parc-auto/contracts build && pnpm --filter @parc-auto/db generate && pnpm --filter @parc-auto/api build",
    "postinstall": "pnpm packages:build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:e2e": "pnpm --filter @parc-auto/e2e test:e2e",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:unit": "pnpm -r --workspace-concurrency=1 --if-present test:unit",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
