{
  "name": "@parc-auto/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parcours navigateur Playwright (Chromium) contre une pile complète de test",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
